{
  "name": "@lovable.dev/ai-gateway",
  "version": "0.1.4",
  "description": "Server-only SDK for the Lovable AI Gateway",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovablelabs/lovable.git",
    "directory": "npm-packages/ai-gateway"
  },
  "homepage": "https://github.com/lovablelabs/lovable/tree/main/npm-packages/ai-gateway#readme",
  "bugs": {
    "url": "https://github.com/lovablelabs/lovable/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "keywords": [
    "lovable",
    "ai",
    "gateway",
    "image-generation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.13.13",
    "@types/ws": "^8.18.1",
    "rimraf": "^5.0.0",
    "tsdown": "^0.22.5",
    "vitest": "^4.1.5",
    "yaml": "2.9.0"
  },
  "bin": {
    "ai-gateway": "./dist/cli/index.js"
  },
  "dependencies": {
    "commander": "14.0.3",
    "openapi-typescript": "7.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "ws": "^8.18.3"
  },
  "scripts": {
    "build": "tsdown",
    "check:package": "tmp=$(mktemp -d) && pnpm pack --out \"$tmp/pkg.tgz\" && tar -xzf \"$tmp/pkg.tgz\" -C \"$tmp\" && publint \"$tmp/package\" --strict && attw \"$tmp/pkg.tgz\"",
    "dev": "tsdown --watch",
    "typecheck": "tsc6 --noEmit",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "lint": "oxfmt --check src/ && cd ../.. && oxlint --deny-warnings --report-unused-disable-directives-severity=error npm-packages/ai-gateway",
    "lint:fix": "oxfmt --write src/ && cd ../.. && oxlint --fix --deny-warnings --report-unused-disable-directives-severity=error npm-packages/ai-gateway",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "generate:contracts": "node scripts/generate-contracts.mjs && oxfmt --write src/contracts"
  }
}