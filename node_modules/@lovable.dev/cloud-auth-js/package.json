{
  "name": "@lovable.dev/cloud-auth-js",
  "version": "1.2.1",
  "description": "Lovable legacy OAuth broker JS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovablelabs/lovable.git",
    "directory": "npm-packages/cloud-auth-js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./lovable-mark.svg": {
      "types": "./assets/lovable-mark.svg.d.ts",
      "default": "./assets/lovable-mark.svg"
    }
  },
  "type": "module",
  "sideEffects": [
    "styles.css"
  ],
  "files": [
    "assets",
    "dist",
    "styles.css"
  ],
  "keywords": [
    "lovable",
    "oauth",
    "broker",
    "authentication"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^26",
    "rimraf": "^5.0.0",
    "tsdown": "^0.22.5",
    "typescript": "7.0.2",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "build": "tsdown",
    "check:package": "tmp=$(mktemp -d) && pnpm pack --out \"$tmp/pkg.tgz\" && tar -xzf \"$tmp/pkg.tgz\" -C \"$tmp\" && publint \"$tmp/package\" --strict && attw \"$tmp/pkg.tgz\"",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "clean": "rimraf dist"
  }
}